{
    "connection_strict_mode": false,
    "forwarding_strict_mode": false,
    "max_per_second_data_rate_byte": 0,
    "max_tx_op_rate": 0,
    "accounting_interval_ms": 0,
    "max_write_buffer_byte": 2097152,
    "max_connections": 1500,
    "num_worker_threads": 2,
    "tick_rate_hz": 500,
    "max_ips": 0,
    "chat_censor": {
        "enabled": false,
        "mode": "mask",
        "replacement": "*",
        "patterns": [
            "\\bf[^a-z0-9]*[uc][^a-z0-9]*[cu][^a-z0-9]*k\\b",
            "\\bs[^a-z0-9]*h[^a-z0-9]*i[^a-z0-9]*t\\b",
            "\\bb[^a-z0-9]*i[^a-z0-9]*t[^a-z0-9]*c[^a-z0-9]*h\\b",
            "\\ba[^a-z0-9]*s[^a-z0-9]*s[^a-z0-9]*h[^a-z0-9]*o[^a-z0-9]*l[^a-z0-9]*e\\b",
            "\\bb[^a-z0-9]*a[^a-z0-9]*s[^a-z0-9]*t[^a-z0-9]*a[^a-z0-9]*r[^a-z0-9]*d\\b"
        ]
    }
}
